# Optional SMTP credentials; empty values enable the local mail stub.
SMTP_USER=
SMTP_PASSWORD=

# Matching base64 Ed25519 keys; empty values generate ephemeral keys.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Set unique, persistent secrets before starting the server.
POSTGRES_PASSWORD=
PEPPER=

# Qwen agent: configure provider-issued endpoint and model name.
LLM_PROVIDER=llama_cpp
LLM_BASE_URL=http://host.docker.internal:18082/v1
LLM_MODEL=qwen3.5-9b
LLM_API_KEY=
AGENT_TOOLS_MODE=unavailable
