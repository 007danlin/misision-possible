        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status",
        "message"
      ],
      "title": "Check",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "no_connections": {
          "default": false,
          "title": "No Connections",
          "type": "boolean"
        },
        "no_night_travel": {
          "default": false,
          "title": "No Night Travel",
          "type": "boolean"
        },
        "no_night_flights": {
          "default": false,
          "title": "No Night Flights",
          "type": "boolean"
        },
        "free_cancellation": {
          "default": false,
          "title": "Free Cancellation",
          "type": "boolean"
        },
        "pets": {
          "default": false,
          "title": "Pets",
          "type": "boolean"
        },
        "other": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Other",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "Dates": {
