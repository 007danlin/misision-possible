# Container-local Qwen. No API key or host runtime required.
# По умолчанию: llama_cpp
LLM_PROVIDER=
# По умолчанию: http://model:8082/v1
LLM_BASE_URL=
# По умолчанию: qwen3.5-9b
LLM_MODEL=
LLM_API_KEY=
# По умолчанию: demo
AGENT_TOOLS_MODE=
# По умолчанию: 300
AGENT_TURN_TIMEOUT_SECONDS=

# Docker selects the native CPU architecture (arm64 on Apple Silicon, amd64 on x86).
# DOCKER_DEFAULT_PLATFORM may override it explicitly; do not emulate x86 for CPU inference.
# The optional native scripts/local.py launcher keeps its own loopback config.

# public: реальные карточки Островка + оценка дороги/трансферов.
# synthetic: прежний отдельный вымышленный каталог, без внешнего поиска.
# По умолчанию: public
JOURNEY_DATA_SOURCE=

# Optional server-only cached Aviasales prices. Never expose in browser code.
TRAVELPAYOUTS_TOKEN=
# Optional production map provider and identifiable public-data client.
# По умолчанию: https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_URL=
# По умолчанию: OPlan-Hackathon/1.0 https://github.com/ostrovok-hackathon-2026/misision-possible
PUBLIC_DATA_USER_AGENT=

# Путь к описанию локальной модели (по умолчанию docs/local-runtime.json).
MODEL_LOCK=
# Число CPU-потоков модели (по умолчанию 4).
MODEL_THREADS=
